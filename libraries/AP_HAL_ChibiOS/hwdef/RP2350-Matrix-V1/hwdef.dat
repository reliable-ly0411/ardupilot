# Waveshare RP2350-Matrix, QFN60, 12 MHz crystal, W25Q128JV boot flash.
MCU PICO2 PICO2
OSCILLATOR_HZ 12000000
MCU_CLOCKRATE_MHZ 150
APJ_BOARD_ID 54071
FLASH_SIZE_KB 16384
FLASH_RESERVE_START_KB 64
define RP_FLASH_SIZE (BOARD_FLASH_SIZE * 1024U)
define AP_BOOTLOADER_FLASHING_ENABLED 0
STORAGE_FLASH_PAGE 8
define HAL_STORAGE_SIZE 8192
define AP_FLASH_STORAGE_QUAD_PAGE 1
define AP_STORAGE_NO_WRITE_WHILE_ARMED 1
define HAL_WITH_RAMTRON 0
USB_STRING_MANUFACTURER "Waveshare"
SERIAL_ORDER OTG1 UART0 UART1 PIOUART0 PIOUART1
PB0 OTG_FS_DM OTG1
PB1 OTG_FS_DP OTG1
PA18 UART0_TX UART0
PA19 UART0_RX UART0
PA26 UART1_TX UART1
PA27 UART1_RX UART1
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_GPS

# PIO0 state machines 0/1 and 2/3. Both ports can operate simultaneously.
PA22 PIOUART0_TX INPUT FLOATING
PA23 PIOUART0_RX INPUT FLOATING
PA20 PIOUART1_TX INPUT FLOATING
PA21 PIOUART1_RX INPUT FLOATING
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_None
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_None

# Eight consecutive edge pads. Each A/B pair shares its period.
PA10 PWM5_A TIM5 PWM(1) GPIO(50)
PA11 PWM5_B TIM5 PWM(2) GPIO(51)
PA12 PWM6_A TIM6 PWM(3) GPIO(52)
PA13 PWM6_B TIM6 PWM(4) GPIO(53)
PA14 PWM7_A TIM7 PWM(5) GPIO(54)
PA15 PWM7_B TIM7 PWM(6) GPIO(55)
PA16 PWM0_A TIM0 PWM(7) GPIO(56)
PA17 PWM0_B TIM0 PWM(8) GPIO(57)
PA24 AUX1 INPUT PULLDOWN GPIO(58)
PA0 AUX2 INPUT PULLDOWN GPIO(59)
PA1 AUX3 INPUT PULLDOWN GPIO(60)

# AP bus 0 is private to the IMU. Bus 1 is available at the board edge.
I2C_ORDER I2C1 I2C0
PA6 I2C1_SDA I2C1
PA7 I2C1_SCL I2C1
PA28 I2C0_SDA I2C0
PA29 I2C0_SCL I2C0
NODMA I2C*
# The private QMI bus has no discrete pull-ups on the schematic.
define HAL_RP_I2C1_PAD_FLAGS PAL_RP_PAD_PUE
define HAL_I2C_INTERNAL_MASK 1
define HAL_I2C_MAX_CLOCK 400000
define RP_I2C_USE_I2C0 TRUE
define RP_I2C_USE_I2C1 TRUE
IMU QMI8658 I2C:0:0x6b ROTATION_ROLL_180
define AP_INS_QMI8658_ENABLED 1
# Optional external barometer. Allow bench boot with only the onboard IMU.
BARO BMP280 I2C:1:0x76
BARO BMP280 I2C:1:0x77
define HAL_BARO_ALLOW_INIT_NO_BARO 1
define AP_COMPASS_PROBING_ENABLED 1

undef HAL_CHIBIOS_ARCH_FMUV3
define HAL_WITH_EKF_DOUBLE 0
define HAL_EKF_IMU_MASK_DEFAULT 1
define AP_FEATURE_BOARD_DETECT 0
define HAL_HAVE_SAFETY_SWITCH 0
define HAL_HAVE_IMU_HEATER 0
define HAL_OS_FATFS_IO 0
define HAL_LOGGING_BACKENDS_DEFAULT 0
define HAL_WITH_DSP FALSE
define HAL_GYROFFT_ENABLED 0
define AP_CRASHDUMP_ENABLED 0
define HAL_DSHOT_ENABLED 0
define HAL_SERIALLED_ENABLED 0
define HAL_SERIAL_ESC_COMM_ENABLED 0
define AP_NOTIFY_OREOLED_ENABLED 0
define HAL_USE_PAL TRUE
define HAL_USE_SIO TRUE
define HAL_USE_I2C TRUE
define HAL_USE_SPI FALSE
define HAL_USE_ADC FALSE
define HAL_USE_CAN FALSE
define HAL_USE_EFL TRUE
define HAL_USE_ICU FALSE
define HAL_USE_PWM TRUE
define HAL_USE_SDC FALSE
define HAL_USE_SERIAL FALSE
define HAL_USE_SERIAL_USB TRUE
define HAL_USE_UART FALSE
define AP_HAL_UARTDRIVER_ENABLED 1
define HAL_USE_USB TRUE
define RP_USB_USE_USB1 TRUE
define HAL_USE_WDG TRUE
define PAL_USE_CALLBACKS TRUE
define PAL_USE_WAIT TRUE
define CH_CFG_SMP_MODE TRUE
define RP_CORE1_START TRUE
define AP_RCOUT_USE_32BIT_TIME 1
define AP_GCS_UPDATE_RATE_HZ 25
define AP_RATE_THREAD_STACK_SIZE 3072
define AP_INERTIAL_SENSOR_RATE_LOOP_BUFFER_SIZE 32
# Matrix omits SPI, SD and DShot functions profiled on RPI_UAVFC.
env RP2350_PARTIAL_RAMFUNC_REGISTRY 1
AUTOBUILD_TARGETS None
